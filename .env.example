# =============================================================================
# Prompt2Learn.ai — environment configuration
# Copy to .env and fill in the values you need. NEVER commit real keys.
# =============================================================================

# --- API keys (configure at least one provider) ------------------------------
# Gemini (first-class provider). Either name works; GEMINI_API_KEY is preferred.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Claude (Anthropic)
CLAUDE_API_KEY=

# OpenAI (also required for OpenAI TTS narration)
OPENAI_API_KEY=

# --- Gemini role-based model routing -----------------------------------------
# Fast model for script + scene JSON generation.
GEMINI_SCRIPT_MODEL=gemini-3.1-flash-lite
# High-quality model for Manim animation code (e.g. Gemini 3.6 Flash).
GEMINI_ANIMATION_MODEL=gemini-3.6-flash
# Model used to repair invalid JSON / failed Manim compilations.
GEMINI_REPAIR_MODEL=gemini-3.6-flash
# Fallback used ONLY after the selected model's retry policy is exhausted or it
# is in cooldown. Leave blank to disable in-provider fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Model for the visual-direction (storyboard) pass. Blank -> uses the animation
# model (the strongest configured model directs the visuals).
GEMINI_STORYBOARD_MODEL=

# --- Gemini retry / cooldown / concurrency -----------------------------------
# The google-genai SDK performs the actual retries (exponential backoff + jitter)
# for 408/429/5xx/timeout. These tune that single retry system — do not add a
# second retry loop elsewhere.
GEMINI_RETRY_ATTEMPTS=4
GEMINI_RETRY_INITIAL_DELAY=1.0
GEMINI_RETRY_MAX_DELAY=30.0
GEMINI_RETRY_EXP_BASE=2.0
GEMINI_RETRY_JITTER=1.0
# After this many consecutive 429s a model is put into cooldown for N seconds.
GEMINI_COOLDOWN_THRESHOLD=2
GEMINI_COOLDOWN_SECONDS=60
# Bounded in-process concurrency limit for Gemini calls (prevents retry storms).
GEMINI_MAX_CONCURRENCY=2
# Set to false to disable automatic fallback to GEMINI_FALLBACK_MODEL.
LLM_FALLBACK_ENABLED=true

# --- Claude / OpenAI models --------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1

# --- TTS configuration -------------------------------------------------------
# Default provider: openai | edge (Edge Neural TTS is free, no key required).
TTS_PROVIDER=openai
TTS_MODEL=tts-1
VOICE=alloy
# Edge TTS speaking-rate adjustment, e.g. +0%, -10%, +15%
EDGE_TTS_RATE=+0%

# --- Caching (content-addressed, shared across jobs) -------------------------
SCRIPT_CACHE_ENABLED=true
SCENE_CACHE_ENABLED=true
TTS_CACHE_ENABLED=true

# --- Visual direction & visual QA --------------------------------------------
# Master toggle for the storyboard (visual-direction) pass.
STORYBOARD_ENABLED=true
# Max scene-level visual repairs when a rendered scene comes out blank (per scene).
VISUAL_REPAIR_ATTEMPTS=1
# Keep advisory findings in the QA report without automatically rerendering.
# Set true only for slower final-quality generation.
AUTO_REPAIR_ADVISORY_QA=false
# Per-job contact sheet + heuristic visual-QA report.
CONTACT_SHEET_ENABLED=true
VISUAL_QA_ENABLED=true
# Optional override of the global visual style contract (blank -> sensible default).
GLOBAL_VISUAL_STYLE=
# Manim render quality: low (480p15, fast) | medium (720p30) | high (1080p60).
MANIM_QUALITY=low
# Concurrent scene builders. Default 4; use 1-2 on low-memory machines.
RENDER_WORKERS=4
# Visual-QA tuning (advisory heuristics; flags never auto-reject a scene).
QA_FRAMES_PER_SCENE=3
QA_BLANK_CONTENT_RATIO=0.0025
QA_WHITE_MIN_BRIGHTNESS=247
QA_MIN_STDDEV=1.5
QA_EDGE_CONTENT_RATIO=0.020
QA_NEAR_IDENTICAL_MAE=4.0
QA_MIN_SCENE_CHANGE_MAE=2.0

# --- Server ------------------------------------------------------------------
# Port the Flask app listens on (must match Docker EXPOSE / compose mapping).
PORT=5000

# --- FFmpeg / FFprobe (override only if not on PATH) -------------------------
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
